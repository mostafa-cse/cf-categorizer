# =================================================================
# CF Categorizer - Environment Variables for Vercel Deployment
# =================================================================

# 1. Google OAuth 2.0 Client ID (Google Identity Services)
# Create free at: https://console.cloud.google.com/apis/credentials
# Authorized JavaScript Origins: https://your-app.vercel.app, http://localhost:3000
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# 2. Serverless Database Connection URL (PostgreSQL)
# Works with:
# - Vercel Postgres (Storage tab in Vercel project dashboard)
# - Supabase (https://supabase.com -> Project Settings -> Database -> Connection URI)
# - Neon (https://neon.tech -> Connection Details)
# - Any PostgreSQL database
DATABASE_URL=postgres://default:your-password@your-host-pooler.region.postgres.vercel-storage.com:5432/verceldb?sslmode=require
